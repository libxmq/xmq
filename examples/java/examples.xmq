// The Java examples, listed on the Java api page (javaapi.html) by web/resources/genjavaapi.xslq.
// Each example is a directory with Class.java and a Makefile.
examples {
    example(name  = load_config_file
            class = LoadConfigFile) {
        title = 'Load a config file'
        summary = 'Parse car.xmq and read strings, integers and doubles with xpaths.'
    }
    example(name  = create_dom
            class = CreateDom) {
        title = 'Create a document'
        summary = 'Build a small document from scratch and print it as compact xmq.'
    }
    example(name  = create_html
            class = CreateHtml) {
        title = 'Create html'
        summary = 'Build a page with a doctype, elements and attributes, print it as html.'
    }
    example(name  = create_json
            class = CreateJson) {
        title = 'Create json'
        summary = 'Build a document with a string and an array, print it as json.'
    }
    example(name  = default_namespace
            class = DefaultNamespace) {
        title = 'Default namespace'
        summary = 'Declare a default namespace on the root and inherit it in the children.'
    }
    example(name  = namespace_prefixes
            class = NamespacePrefixes) {
        title = 'Namespace prefixes'
        summary = 'Mix namespaces with prefixes and elements in no namespace.'
    }
    example(name  = add_namespace
            class = AddNamespace) {
        title = 'Add a namespace'
        summary = 'Declare an extra namespace with addNamespace and use it with NS.ancestor.'
    }
    example(name  = generated_prefixes
            class = GeneratedPrefixes) {
        title = 'Generated prefixes'
        summary = 'NS.ancestor with an undeclared namespace declares it on the root as ns1, ns2...'
    }
    example(name  = parse_with_ixml
            class = ParseWithIxml) {
        title = 'Parse with ixml'
        summary = 'Parse text with an ixml grammar, sum the values with forEach and time it.'
    }
    example(name  = line_printf
            class = LinePrintf) {
        title = 'Log lines'
        summary = 'Print xmq log lines with LineConfig.printf, or the same lines human readable.'
    }
}
