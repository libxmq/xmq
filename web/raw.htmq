!DOCTYPE = html
html {
    head {
        meta(http-equiv = content-type
             content    = 'text/html; charset=UTF-8')
        title = libxmq
        link(type = text/css
             href = style.css
             rel  = stylesheet)
        link(type = text/css
             href = xmq.css
             rel  = stylesheet)
        script(type = text/javascript
               src  = code.js) = ''
        meta(name          = viewport
             content       = width=device-width
             initial-scale = 1.0)
        meta(name    = color-scheme
             content = 'light dark')
        style = 'body.xmq_auto { max-width: 150ch; }'
    }
    body(class = xmq_auto)
    {
        button(type = button
               title = 'Show as original xml'
               onClick = 'goXML();') = 'Show as XML'
        ' '
        button(type = button
               title = 'Show as xmq'
               onClick = 'goXMQ();') = 'Show as XMQ'
        br
        pre(class = 'xmq xmq_auto w80')
        {
            &RAW;
        }
    }
}
