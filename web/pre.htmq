!DOCTYPE = html
html {
    head {
        meta(http-equiv = content-type
             content    = 'text/html; charset=UTF-8')
        title = libxmq
        link(type = text/css
             href = style.css
             rel  = stylesheet)
        link(type = text/css
             href = xmq.css
             rel  = stylesheet)
        script(type = text/javascript
               src  = code.js) = ''
        meta(name          = viewport
             content       = width=device-width
             initial-scale = 1.0)
        style = 'body.light { max-width: 150ch; } body.dark { max-width: 150ch; }'
    }
    body(onload='checkBackgroundSetting();' class='dark')
    {
        button(type = button
               title = 'Set functional cookie background=dark'
               onClick = 'goDark();') = 'Dark Mode'
        ' '
        button(type = button
               title = 'Set functional cookie background=light'
               onClick = 'goLight();') = 'Light Mode'
        ' '
        button(type = button
               title = 'Show as original xml'
               onClick = 'goXML();') = 'Show as XML'
        ' '
        button(type = button
               title = 'Show as xmq'
               onClick = 'goXMQ();') = 'Show as XMQ'
        br
        &PRE;
    }
}
