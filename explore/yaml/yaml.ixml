yaml = line++-#a.
-line = kv | obj.
obj = indent, @key, -':'.
kv  = indent, @key, -': ', -value.
-indent = i0 | i1 | i2 | i3 | i4 | i5 | i6 | i7 | i8 | i9 | i10.

key = ~[' ';':'], ~[':']*.

value = ~[#a]+.

-i0 = @a0.
-i1 = -' ', @a1.
-i2 = -'  ', @a2.
-i3 = -'   ', @a3.
-i4 = -'    ', @a4.
-i5 = -'     ', @a5.
-i6 = -'      ', @a6.
-i7 = -'       ', @a7.
-i8 = -'        ', @a8.
-i9 = -'         ', @a9.
-i10 = -'         ', @a10.

a0>n = +'0'.
a1>n = +'1'.
a2>n = +'2'.
a3>n = +'3'.
a4>n = +'4'.
a5>n = +'5'.
a6>n = +'6'.
a7>n = +'7'.
a8>n = +'8'.
a9>n = +'9'.
a10>n = +'10'.