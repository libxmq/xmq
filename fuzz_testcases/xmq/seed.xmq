		</span>







	
	

<header>
	
		<span class="topic" id="topic-186343734">
			<a href="//slashdot.org/index2.pl?fhfilter=earth" onclick="return addfhfilter('earth');">
			
				<img src="//a.fsdn.com/sd/topics/earth_64.png" width="64" height="64" alt="Earth" title="Earth">
			
