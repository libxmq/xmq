START
p = ' '*, ID.
ID = !'i', ['a'-'z'].
INPUT
  i
OUTPUT
ixml(ixml:state = failed
     xmlns:ixml = http://invisiblexml.org/NS)
{
    info   = 'ixml:1:3: syntax error
                i
                ^
              expected p: #20'
    line   = 1
    column = 3
    pos    = 3
    expected(rule = p) = #20
}
END
