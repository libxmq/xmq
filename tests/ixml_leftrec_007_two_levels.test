START
e = -m | e, "+", m. m = -f | m, "*", f. f = [N]+, ![N] | "(", e, ")".
INPUT
1+2*3*(4+5)+6
OUTPUT
e {
    e {
        e = 1
        '+'
        m {
            m {
                m = 2
                '*'
                f = 3
            }
            '*'
            f {
                '('
                e {
                    e = 4
                    '+'
                    m = 5
                }
                ')'
            }
        }
    }
    '+'
    m = 6
}
END
