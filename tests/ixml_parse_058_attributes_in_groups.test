START
o = -'x', (-' ', @v)?, (-' ', @w)*, -' ', (@a, -'.')++-',', -' ', (@b)**-';'.
v = ['a'-'z']+.
w = ['0'-'9']+.
a = ['A'-'Z']+.
b = ['a'-'z']+.
INPUT
x abc 12 34 A.,B. q;r
OUTPUT
ixml(ixml:state = failed
     xmlns:ixml = http://invisiblexml.org/NS)
{
    info = 'dynamic error D02: the attribute w occurs more than once on an element'
}
END
ARGS=
