INPUT
name: demo
on:
push:
  branches:
  - master
  - poster
  houses:
  - one
  - two
  steps:
  - id: S1
    use: a/b
  - id: S2
    run: make

OUTPUT
cmd_007_heu {
    name = demo
    on   = ''
    push {
        branches(A)
        {
            branch = master
            branch = poster
        }
        houses(A)
        {
            house = one
            house = two
        }
        steps(A)
        {
            step {
                id  = S1
                use = a/b
            }
            step {
                id  = S2
                run = make
            }
        }
    }
}
END
ARGS --yaml
CMDS heu
