// v1a Render C source, parsed with lang/c-hilit, with ansi colors in the terminal.
// Fredrik Öhrström (c) 2026 spdx: MIT
//
//   xmq ixml:lang/c-hilit foo.c xsl:lang/c-hilit-to-terminal to-text
//   xmq ixml:lang/c-hilit foo.c xsl:lang/c-hilit-to-terminal to-text | less -R
//
// The colors are the 16 standard ansi colors, so they follow the palette of the
// terminal and work on both dark and light backgrounds.
xsl:stylesheet(version   = 1.0
               xmlns:xsl = http://www.w3.org/1999/XSL/Transform)
{
    xsl:output(method = text)

    // The escape character that starts an ansi color code.
    xsl:variable(name = esc) = &#27;

    xsl:template(match = '/*')
    {
        xsl:apply-templates
    }

    xsl:template(match = 'text()')
    {
        xsl:value-of(select = '.')
    }

    // A syntax element with its color, the color is restored after it. In a preprocessor
    // line the elements are colored and the rest has the color of the line.
    xsl:template(match = '*')
    {
        xsl:variable(name = color) {
            xsl:choose {
                xsl:when(test = 'self::comment') { '2;3' }
                xsl:when(test = 'self::keyword') { '1;33' }
                xsl:when(test = 'self::primitive') { '34' }
                xsl:when(test = 'self::type') { '36' }
                xsl:when(test = 'self::macro') { '35' }
                xsl:when(test = 'self::function') { '1' }
                xsl:when(test = 'self::string or self::char or self::header') { '32' }
                xsl:when(test = 'self::number') { '31' }
                xsl:when(test = 'self::pp') { '1;35' }
                xsl:otherwise { '0' }
            }
        }
        xsl:choose {
            xsl:when(test = '$color = "0"') {
                xsl:apply-templates
            }
            xsl:otherwise {
                xsl:value-of(select = 'concat($esc, "[", $color, "m")')
                xsl:apply-templates
                xsl:value-of(select = 'concat($esc, "[0m")')
            }
        }
    }
}
