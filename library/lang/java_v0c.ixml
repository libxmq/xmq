The grammar parses Java 17 source files, which are UTF-8. The tree has the
contents of the code: names, literals, operators and the structure. Whitespace,
comments and punctuation are dropped. (Comments are for a separate grammar for
syntax coloring and pretty printing.)

The grammar is written for the LL(*) parser generator (xmqj generate-parser)
as well as the ixml engine, in the style of library/lang/c.ixml:

  - Whitespace and comments (ws) are placed at the end of each token, except
    in the first rule, which accepts leading white space. No rule may start
    with ws, otherwise whitespace can be split ambiguously.
  - Tokens use the not operator ! to implement maximal munch, e.g. an
    IDENTIFIER cannot be followed by another identifier character (!idchar) and
    the token + cannot be followed by + or =. Keywords cannot be identifiers
    (!keyword). The contextual keywords (var, yield, record, sealed, permits)
    are identifiers, matched as keywords only where the syntax needs them.
  - > is always a single token, so that List<List<String>> closes two type
    argument lists. The shift operators >> and >>> are > tokens without
    whitespace between them. The assignments >>= and >>>= are tokens.
  - Unicode escapes (A) are only recognized inside char, string and
    text block literals.
  - Literals keep their source text without the quotes, escapes are not
    translated, e.g. "a\n" is STRING_LITERAL = a\n

The tree, eg for public static <T> List<T>[] f(final int x) throws E { ... }

  method(name = f) {
      modifier = public
      modifier = static
      type_parameters { type_parameter(name = T) }
      type { name = List  type_arguments { type { name = T } }  dim }
      parameter(name = x) { modifier = final  type { primitive = int } }
      throws { type { name = E } }
      block
  }

  - Declared names are attributes: class(name = A), variable(name = x), ...
  - A type has a primitive (int) or a dotted name (java.util.List), then its
    type_arguments, and a dim for every []. A name is split only where type
    arguments or annotations come between its parts:
    Outer<String>.Inner is type { name = Outer  type_arguments {...}  name = Inner }
  - wildcard { extends {...} } or wildcard { super {...} } for ? extends T.
  - Annotations and modifiers are kept in source order.
  - void, varargs, static (of an initializer) and dim are empty elements.

Not supported: annotation type declarations (@interface), annotations on
types (eg List<@NonNull String>, annotations before a type are modifiers),
module-info.java
and the Java 21 features (record patterns, patterns in switch). }

{ Step 2 of JAVA_PARSING.txt: the declarations. The bodies of methods,
  constructors and initializers (block), the initializers of fields (init) and
  the arguments of annotations and enum constants (arguments) are skipped as
  balanced brackets, until the statements and expressions are written in
  steps 4 and 5. }

compilation_unit = ws, package?, import_declaration*, type_declaration*.

package = -PACKAGE, -name, -SEMI.

-import_declaration = import | static_import.
import = -IMPORT, -name, on_demand?, -SEMI.
static_import = -IMPORT, -STATIC, -name, on_demand?, -SEMI.
-on_demand = dot, '*', ws.

{ A dotted name, eg java.util.List, is a single name. No rule continues a name
  with a dot and an identifier, so a.b.c is never split. }
name = -IDENTIFIER, (dot, -IDENTIFIER)*.
-dot = '.', !['0'-'9'; '.'], ws.

{ Modifiers and annotations, in any order. sealed and non-sealed are
  contextual keywords. }
-modifiers = (modifier | annotation)*.
modifier = ('public' | 'protected' | 'private' | 'abstract' | 'static' | 'final'
           | 'transient' | 'volatile' | 'synchronized' | 'native' | 'strictfp'
           | 'default' | 'sealed' | 'non-sealed'), !idchar, ws.
annotation = -AT, name, arguments?.

{ Types. var, yield, record, sealed and permits cannot be the name of a type.
  An annotation before the type of a field, method, parameter or record
  component is a modifier. Elsewhere a type can start with annotations, eg
  List<@NonNull String>, implements @A I, throws @A E. }
type = (primitive | class_type), dim*.
annotated_type = annotation+, (primitive | class_type), dim*.
-any_type = type | annotated_type>type.
primitive = ('boolean' | 'byte' | 'short' | 'char' | 'int' | 'long' | 'float' | 'double'),
            !idchar, ws.
{ After its name a class type continues only with type arguments or
  annotations, eg Outer<String>.Inner or Outer.@A Inner, otherwise the name
  has all the dotted parts. }
-class_type = !restricted, name, class_type_rest?.
-class_type_rest = type_arguments, (-DOT, annotation*, name, class_type_rest?)?
                 | -DOT, annotation+, name, class_type_rest?.
-restricted = 'var', notid | 'yield', notid | 'record', notid | 'sealed', notid
            | 'permits', notid.
dim = annotation*, -LBRACKET, -RBRACKET.
type_arguments = -lt, (type_argument++-COMMA)?, -gt.
-type_argument = any_type | wildcard.
wildcard = -'?', ws, (extends | super)?.
super = -SUPER, any_type.

type_parameters = -lt, type_parameter++-COMMA, -gt.
type_parameter = annotation*, @IDENTIFIER>name, extends?.
extends = -EXTENDS, any_type, (-amp, any_type)*.

-lt = -'<', !['<='], ws.
-gt = -'>', !gt_follow, ws.
-amp = -'&', !['&='], ws.
-assign = -'=', !'=', ws.

{ Type declarations }

-type_declaration = class | interface | enum | record | -SEMI.

class = modifiers, -CLASS, @IDENTIFIER>name, type_parameters?, extends?, implements?,
        permits?, body.
interface = modifiers, -INTERFACE, @IDENTIFIER>name, type_parameters?,
            ^interface_extends>extends?, permits?, body.
enum = modifiers, -ENUM, @IDENTIFIER>name, implements?, ^enum_body>body.
record = modifiers, -'record', !idchar, ws, @IDENTIFIER>name, type_parameters?,
         -LPAREN, components?, -RPAREN, implements?, body.

-interface_extends = -EXTENDS, any_type++-COMMA.
implements = -IMPLEMENTS, any_type++-COMMA.
permits = -'permits', !idchar, ws, any_type++-COMMA.

body = -LBRACE, member*, -RBRACE.
-enum_body = -LBRACE, (constant++-COMMA)?, -COMMA?, (-SEMI, member*)?, -RBRACE.
constant = annotation*, @IDENTIFIER>name, arguments?, body?.
-components = (component, -COMMA)*, (component | ^variable_arity_component>component).
component = annotation*, type, @IDENTIFIER>name.
-variable_arity_component = annotation*, type, varargs, @IDENTIFIER>name.

{ Members }

-member = field | method | constructor | compact_constructor | initializer
        | class | interface | enum | record | -SEMI.

field = modifiers, type, variable++-COMMA, -SEMI.
variable = @IDENTIFIER>name, dim*, (-assign, init)?.

method = modifiers, type_parameters?, (type | void), @IDENTIFIER>name,
         -LPAREN, parameters?, -RPAREN, dim*, throws?, (block | -SEMI).
void = -VOID.
constructor = modifiers, type_parameters?, @IDENTIFIER>name,
              -LPAREN, parameters?, -RPAREN, throws?, block.
compact_constructor = modifiers, @IDENTIFIER>name, block.
initializer = static?, block.
static = -STATIC.

{ The first parameter can be the receiver, eg void m(@A Foo this) or, in the
  constructor of an inner class, Inner(Outer Outer.this).
  Only the last parameter can have varargs (...). }
-parameters = receiver, (-COMMA, parameter_list)? | parameter_list.
-parameter_list = (parameter, -COMMA)*, (parameter | ^variable_arity>parameter).
receiver = modifiers, type, (@IDENTIFIER>outer, -DOT)?, -THIS.
parameter = modifiers, type, @IDENTIFIER>name, dim*.
-variable_arity = modifiers, type, varargs, @IDENTIFIER>name.
varargs = annotation*, -ELLIPSIS.
throws = -THROWS, any_type++-COMMA.

{ Skipped for now (step 2): balanced brackets, string, char and text block
  literals and comments are skipped, all the characters are deleted. An init
  ends before a , or ; that is not inside brackets. In an init < starts a group
  that ends with > and can contain commas, eg new HashMap<String, Integer>().
  A < that is a less than has a cost, so the group wins when both fit. }

block = -'{', skip*, -'}', ws.
arguments = -'(', skip*, -')', ws.
init = init_item+.

-skip = -~['{}()[]"/'; "'"] | skip_common.
-init_item = -~[',;{}()[]"/<'; "'"] | init_lt | init_angle | skip_common.
-init_lt =< -'<'.
-init_angle = -'<', (-~['<>;{}()[]"/'; "'"] | init_angle)*, -'>'.
-skip_common = -'/', !['/*'] | -comment | skip_literal
             | -'{', skip*, -'}' | -'(', skip*, -')' | -'[', skip*, -']'.
-skip_literal = -'"""', skip_text_block_char*, -'"""'
              | !'"""', -'"', (-~['"\'; #a; #d] | -'\', -~[#a; #d])*, -'"'
              | -"'", (-~["'\"; #a; #d] | -'\', -~[#a; #d], -['0'-'9'; 'a'-'f'; 'A'-'F'; 'u']*), -"'".
-skip_text_block_char = -~['"\'] | -'"', !'""' | -'\', -~[].

{ Whitespace and comments. The byte order mark is whitespace too. }

-ws = (-[' '; #9; #a; #c; #d; #feff] | -comment)*, !wsstart.
-wsstart = [' '; #9; #a; #c; #d; #feff] | '//' | '/*'.
-comment = -'//', -~[#a; #d]*, !~[#a; #d]
         | -'/*', comment_char*, -'*/'.
-comment_char = -~['*'] | -'*', !'/'.

{ Literals }

INTEGER_LITERAL = (-hex_numeral | -binary_numeral | -digits), ['lL']?, !numchar, ws.
-numchar = [L; Nd; '_'; '.'].
-digits = ['0'-'9'], (['0'-'9'; '_']*, ['0'-'9'])?.
-hex_digits = hex_digit, ([Nd; 'a'-'f'; 'A'-'F'; '_']*, hex_digit)?.
-hex_digit = ['0'-'9'; 'a'-'f'; 'A'-'F'].
-hex_numeral = '0', ['xX'], hex_digits.
-binary_numeral = '0', ['bB'], ['01'], (['01_']*, ['01'])?.

FLOATING_POINT_LITERAL = (-decimal_float | -hex_float), !numchar, ws.
-decimal_float = digits, '.', digits?, exponent?, float_suffix?
               | '.', digits, exponent?, float_suffix?
               | digits, exponent, float_suffix?
               | digits, float_suffix.
-exponent = ['eE'], ['+-']?, digits.
-float_suffix = ['fFdD'].
-hex_float = '0', ['xX'], (hex_digits, '.'? | hex_digits?, '.', hex_digits),
             ['pP'], ['+-']?, digits, float_suffix?.

CHARACTER_LITERAL = -"'", (~["'\"; #a; #d] | -escape), -"'", ws.
STRING_LITERAL = !'"""', -'"', (~['"\'; #a; #d] | -escape)*, -'"', ws.
-escape = '\', ( ['btnfrs"\'; "'"]
               | octal_escape
               | 'u'+, hex_digit, hex_digit, hex_digit, hex_digit).
-octal_escape = ['0'-'3'], ['0'-'7'], ['0'-'7']
              | ['0'-'3'], ['0'-'7'], !['0'-'7']
              | ['4'-'7'], ['0'-'7']
              | ['0'-'7'], !['0'-'7'].

{ A text block starts with """ and the rest of the line, the contents start on
  the next line and end with """. A " or "" in the contents is not the end. }
TEXT_BLOCK = -'"""', -[' '; #9; #c]*, -#d?, -#a, (-text_block_char)*, -'"""', ws.
-text_block_char = ~['"\']
                 | '"', !'""'
                 | escape
                 | '\', #d?, #a.

{ Separators, they are not part of the tree. }

-LPAREN = -'(', ws.
-RPAREN = -')', ws.
-LBRACE = -'{', ws.
-RBRACE = -'}', ws.
-LBRACKET = -'[', ws.
-RBRACKET = -']', ws.
-SEMI = -';', ws.
-COMMA = -',', ws.
-DOT = -'.', !['0'-'9'; '.'], ws.
-ELLIPSIS = -'...', ws.
-AT = -'@', ws.
-COLONCOLON = -'::', ws.


{ Operators }

ASSIGN = '=', !'=', ws.
GT = '>', !gt_follow, ws.
-gt_follow = '=' | '>=' | '>>='.
LT = '<', !['<='], ws.
NOT = '!', !'=', ws.
TILDE = '~', ws.
QUESTION = '?', ws.
COLON = ':', !':', ws.
ARROW = '->', ws.
EQ = '==', ws.
GE = '>=', ws.
LE = '<=', ws.
NE = '!=', ws.
AND = '&&', ws.
OR = '||', ws.
INC = '++', ws.
DEC = '--', ws.
PLUS = '+', !['+='], ws.
MINUS = '-', !['-=>'], ws.
STAR = '*', !'=', ws.
SLASH = '/', !['/*='], ws.
BITAND = '&', !['&='], ws.
BITOR = '|', !['|='], ws.
CARET = '^', !'=', ws.
PERCENT = '%', !'=', ws.
SHL = '<<', !'=', ws.
PLUS_ASSIGN = '+=', ws.
MINUS_ASSIGN = '-=', ws.
STAR_ASSIGN = '*=', ws.
SLASH_ASSIGN = '/=', ws.
AND_ASSIGN = '&=', ws.
OR_ASSIGN = '|=', ws.
XOR_ASSIGN = '^=', ws.
MOD_ASSIGN = '%=', ws.
SHL_ASSIGN = '<<=', ws.
SHR_ASSIGN = '>>=', ws.
USHR_ASSIGN = '>>>=', ws.


{ Identifiers and keywords. An identifier is not a keyword, eg classes, done
  and if_x are identifiers. true, false, null and _ are reserved as well. }

IDENTIFIER = !keyword, idstart, idchar*, !idchar, ws.
-idstart = [L; Nl; Sc; Pc].
-idchar = [L; Nl; Sc; Pc; Nd; Mn; Mc].

-keyword = 'abstract', notid
         | 'assert', notid
         | 'boolean', notid
         | 'break', notid
         | 'byte', notid
         | 'case', notid
         | 'catch', notid
         | 'char', notid
         | 'class', notid
         | 'const', notid
         | 'continue', notid
         | 'default', notid
         | 'do', notid
         | 'double', notid
         | 'else', notid
         | 'enum', notid
         | 'extends', notid
         | 'final', notid
         | 'finally', notid
         | 'float', notid
         | 'for', notid
         | 'goto', notid
         | 'if', notid
         | 'implements', notid
         | 'import', notid
         | 'instanceof', notid
         | 'int', notid
         | 'interface', notid
         | 'long', notid
         | 'native', notid
         | 'new', notid
         | 'package', notid
         | 'private', notid
         | 'protected', notid
         | 'public', notid
         | 'return', notid
         | 'short', notid
         | 'static', notid
         | 'strictfp', notid
         | 'super', notid
         | 'switch', notid
         | 'synchronized', notid
         | 'this', notid
         | 'throw', notid
         | 'throws', notid
         | 'transient', notid
         | 'try', notid
         | 'void', notid
         | 'volatile', notid
         | 'while', notid
         | 'true', notid
         | 'false', notid
         | 'null', notid
         | '_', notid.
-notid = ~[L; Nl; Sc; Pc; Nd; Mn; Mc].

-ABSTRACT = -'abstract', !idchar, ws.
-ASSERT = -'assert', !idchar, ws.
-BOOLEAN = -'boolean', !idchar, ws.
-BREAK = -'break', !idchar, ws.
-BYTE = -'byte', !idchar, ws.
-CASE = -'case', !idchar, ws.
-CATCH = -'catch', !idchar, ws.
-CHAR = -'char', !idchar, ws.
-CLASS = -'class', !idchar, ws.
-CONST = -'const', !idchar, ws.
-CONTINUE = -'continue', !idchar, ws.
-DEFAULT = -'default', !idchar, ws.
-DO = -'do', !idchar, ws.
-DOUBLE = -'double', !idchar, ws.
-ELSE = -'else', !idchar, ws.
-ENUM = -'enum', !idchar, ws.
-EXTENDS = -'extends', !idchar, ws.
-FINAL = -'final', !idchar, ws.
-FINALLY = -'finally', !idchar, ws.
-FLOAT = -'float', !idchar, ws.
-FOR = -'for', !idchar, ws.
-GOTO = -'goto', !idchar, ws.
-IF = -'if', !idchar, ws.
-IMPLEMENTS = -'implements', !idchar, ws.
-IMPORT = -'import', !idchar, ws.
-INSTANCEOF = -'instanceof', !idchar, ws.
-INT = -'int', !idchar, ws.
-INTERFACE = -'interface', !idchar, ws.
-LONG = -'long', !idchar, ws.
-NATIVE = -'native', !idchar, ws.
-NEW = -'new', !idchar, ws.
-PACKAGE = -'package', !idchar, ws.
-PRIVATE = -'private', !idchar, ws.
-PROTECTED = -'protected', !idchar, ws.
-PUBLIC = -'public', !idchar, ws.
-RETURN = -'return', !idchar, ws.
-SHORT = -'short', !idchar, ws.
-STATIC = -'static', !idchar, ws.
-STRICTFP = -'strictfp', !idchar, ws.
-SUPER = -'super', !idchar, ws.
-SWITCH = -'switch', !idchar, ws.
-SYNCHRONIZED = -'synchronized', !idchar, ws.
-THIS = -'this', !idchar, ws.
-THROW = -'throw', !idchar, ws.
-THROWS = -'throws', !idchar, ws.
-TRANSIENT = -'transient', !idchar, ws.
-TRY = -'try', !idchar, ws.
-VOID = -'void', !idchar, ws.
-VOLATILE = -'volatile', !idchar, ws.
-WHILE = -'while', !idchar, ws.
-TRUE = -'true', !idchar, ws.
-FALSE = -'false', !idchar, ws.
-NULL = -'null', !idchar, ws.
-UNDERSCORE = -'_', !idchar, ws.

