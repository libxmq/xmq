// An xmq document that uses most of the xmq language.
!DOCTYPE = html
?xml-stylesheet = 'href="style.css" type="text/css"'
/* A multi line comment
   with incidental indentation
     that is kept relative. */
//* A comment with /* inside */ *//
/* A comment */* with a continuation */
html(xmlns:svg = http://www.w3.org/2000/svg
     lang      = en)
{
    head {
        title = 'Hello &amp; welcome'
        meta(charset = utf-8)
    }
    body(class = ('main' &#32; 'wide'))
    {
        h1 = Greetings
        p {
            'Some text'
            &nbsp;
            'and more,'
            &#10;
            'a new line.'
        }
        pre = '''
              A quote with 'quotes' inside
                and indentation
              '''
        empty = ''
        nothing
        link(href = &amp; title = ('a' &nbsp; 'b'))
        svg:svg(width = 10)
        {
            svg:rect(x = 1 y = 2)
        }
        local:thing(local:attr = 1)
        <p class="xml">Embedded <b>xml</b></p>
        dotted.name-with_chars = 1.5e3
        // A last comment
    }
}
