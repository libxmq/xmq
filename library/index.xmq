    file(path        = measurement/taf-to-html.xslq
         size        = 71799
         sha256      = 417ba924d90f7d49413d028e3e8865d6df9e18bfbb5301f04a9d8f4113c6ca9d
         mtime       = 2026-11-20T22:15:06Z
         version     = 1a
         description = 'Render a TAF forecast, parsed with taf.ixml, as a web page:
                          xmq ixml:measurement/taf taf.inp xsl:measurement/taf-to-html to-html > taf.html

                        A blue header shows the station, the issue time, the validity period, the
                        flight category (VFR, MVFR, IFR, LIFR) of the base forecast and the maximum
                        and minimum temperatures.

                        A timeline spans the validity period. The prevailing conditions, the base
                        forecast and the FM groups, are drawn on the first row, every BECMG, TEMPO,
                        INTER and PROB group gets a row of its own. The bars are colored by the
                        flight category of their conditions, a BECMG bar fades into the new
                        conditions that then last until the next FM group.

                        Below every period gets a card with a weather icon, the wind arrow, the
                        visibility, the weather and the cloud layers with their okta symbols.')
    file(path        = measurement/taf-to-html_v1.xslq
         size        = 71799
         sha256      = 417ba924d90f7d49413d028e3e8865d6df9e18bfbb5301f04a9d8f4113c6ca9d
         mtime       = 2026-11-20T22:15:06Z
         version     = 1a
         description = 'Render a TAF forecast, parsed with taf.ixml, as a web page:
                          xmq ixml:measurement/taf taf.inp xsl:measurement/taf-to-html to-html > taf.html

                        A blue header shows the station, the issue time, the validity period, the
