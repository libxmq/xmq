    file(path        = lang/java-hilit.ixml
         size        = 5259
         sha256      = 460a8413628ad3eea22b26f812931f4f9755dccf7bef6542c967ffcdbb392110
         mtime       = 2026-11-22T15:18:11Z
         version     = 1a
         summary     = 'Find the syntax elements of Java source code, for syntax highlighting.'
         description = '''Find the syntax elements of Java source code, for syntax highlighting.
                          Fredrik Öhrström (c) 2026 spdx: MIT

                          Unlike java.ixml this grammar does not parse the structure, every character of the
                          source is kept, so the text of the parse is the source. Whitespace and punctuation
                          are plain text, the rest is marked up:

                            comment     /* ... */ and // ...
                            javadoc     /** ... */ with the block and inline tags as tag, eg @param
                            annotation  @Override, @java.lang.Deprecated
                            string      "..." and text blocks """..."""
                            char        'x'
                            number      12, 0x1f, 1_000L, 1.5e3f
                            keyword     if, return, class, public, new, var, record, true, null...
                            primitive   boolean, byte, char, short, int, long, float, double, void
                            type        a name starting with an upper case letter that has a lower case
                                        letter, or a single upper case letter, eg String or T
                            constant    a name with only upper case letters, digits and _, eg MAX_VALUE
                            function    a lower case name followed by (, eg a method call or declaration
                            name        the other names, eg variables, fields and packages

                          Render it with lang/java-hilit-to-html or lang/java-hilit-to-terminal:

                            xmq ixml:lang/java-hilit Foo.java xsl:lang/java-hilit-to-html to-html > Foo.html
                            xmq ixml:lang/java-hilit Foo.java xsl:lang/java-hilit-to-terminal to-text''')
