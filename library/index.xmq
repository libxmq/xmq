         size        = 22933
         sha256      = 2a57f0ffed2436c41dfe528a55ba8469e98206ac4a9baf28d1bd4f35174e756e
         mtime       = 2026-11-22T15:18:11Z
         version     = 1a
         summary     = 'Render an ixml trace, recorded with xmq --traceixml=parse.xmq (or xmqj), in the terminal'
