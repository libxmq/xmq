    file(path        = lang/c-hilit.ixml
         size        = 6051
         sha256      = 949ad53f0ee17637f50ebf5d3fb8822edf4e56822f6a03b80cd6bec75651c316
         mtime       = 2026-11-22T20:49:59Z
         version     = 1b
         summary     = 'Find the syntax elements of C source code, for syntax highlighting.'
         description = '''Find the syntax elements of C source code, for syntax highlighting.
                          Fredrik Öhrström (c) 2026 spdx: MIT

                          Unlike c.ixml this grammar parses the raw source, before the preprocessor, and
                          every character of the source is kept, so the text of the parse is the source.
                          Whitespace and punctuation are plain text, the rest is marked up:

                            comment    /* ... */ and // ...
                            preproc    a preprocessor line, with the directive as pp, eg #include,
                                       the included file as header and a defined name as macro
                            string     "..."            char       '...'
                            number     12, 0x1f, 1.5e3f
                            keyword    if, return, struct, typedef...
                            primitive  int, char, bool, size_t, uint32_t...
                            type       a name starting with an upper case letter that has a lower case
                                       letter, eg XMQDoc
                            macro      a name with only upper case letters, digits and _, eg NULL, XMQ_ATTRS
                            function   a lower case name followed by (, eg a call or a declaration
                            name       the other names, eg variables

                          Since it is the source before the preprocessor, the markup is a guess, eg a type
                          name in lower case is a name. Render it with lang/c-hilit-to-html or
                          lang/c-hilit-to-terminal:

                            xmq ixml:lang/c-hilit foo.c xsl:lang/c-hilit-to-html to-html > foo.html
                            xmq ixml:lang/c-hilit foo.c xsl:lang/c-hilit-to-terminal to-text''')
    file(path        = lang/c-hilit_v1.ixml
         size        = 6051
         sha256      = 949ad53f0ee17637f50ebf5d3fb8822edf4e56822f6a03b80cd6bec75651c316
         mtime       = 2026-11-22T20:49:59Z
         version     = 1b
         summary     = 'Find the syntax elements of C source code, for syntax highlighting.'
